services:
  unfunny:
    build: .
    image: unfunny:local
    container_name: unfunny
    restart: unless-stopped
    environment:
      - PORT=8004
      # If you run a modified copy, point this at your own source (AGPL):
      # - SOURCE_URL=https://example.org/your/unfunny
    ports:
      - "127.0.0.1:8004:8004"
